{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Lidarr": {
    "BaseUrl": "http://lidarr:8686",
    "ApiKey": "",
    "DefaultRootFolder": "/music",
    "DefaultQualityProfileId": 1,
    "DefaultMetadataProfileId": 1,
    "DefaultMonitor": "all",
    "SearchOnAdd": false
  },
  "Library": {
    "Path": "data/music"
  },
  "Database": {
    "Path": "data/tunarrly.db"
  },
  "AI": {
    "Enabled": false,
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "Model": "gpt-4.1-mini",
    "Temperature": 0.3,
    "TimeoutSeconds": 60,
    "MaxInputArtists": 200,
    "MaxRecommendations": 25
  }
}
