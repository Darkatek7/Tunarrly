@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="tunarrly-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="fw-800">Tunarrly</MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Class="appbar-chip">Local-first discovery</MudChip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="tunarrly-drawer">
        <MudDrawerHeader>
            <div>
                <MudText Typo="Typo.h5" Class="brand-title">Tunarrly</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Discovery for Lidarr</MudText>
            </div>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 pa-md-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Black = "#050608",
            Background = "#0b0d10",
            Surface = "#151922",
            DrawerBackground = "#10141b",
            AppbarBackground = "#0d1117",
            Primary = "#d6a84f",
            Secondary = "#8fa38b",
            Tertiary = "#b8734d",
            Info = "#7f8fa6",
            Success = "#8fa38b",
            Warning = "#d6a84f",
            Error = "#c45f56"
        },
        Typography = new Typography { Default = new DefaultTypography { FontFamily = ["Inter", "sans-serif"] } }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
