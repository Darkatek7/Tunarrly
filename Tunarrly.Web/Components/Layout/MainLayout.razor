@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="tunarrly-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <div class="topbar-brand">
            <MudText Typo="Typo.h6" Class="fw-800">Tunarrly</MudText>
            <span>Local music radar</span>
        </div>
        <MudSpacer />
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Class="appbar-chip">Local-first discovery</MudChip>
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Href="/logout" Color="Color.Inherit" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="tunarrly-drawer">
        <MudDrawerHeader>
            <div class="drawer-brand">
                <div class="brand-mark">T</div>
                <MudText Typo="Typo.h5" Class="brand-title">Tunarrly</MudText>
                <MudText Typo="Typo.caption">Discovery for Lidarr</MudText>
            </div>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 pa-md-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Black = "#090807",
            Background = "#11100e",
            Surface = "#191714",
            DrawerBackground = "#13120f",
            AppbarBackground = "#12110f",
            Primary = "#f0b94f",
            Secondary = "#b7a98b",
            Tertiary = "#c06f45",
            Info = "#9aa5b1",
            Success = "#9bb879",
            Warning = "#f0b94f",
            Error = "#d9685f",
            TextPrimary = "#f4efe4",
            TextSecondary = "#bdb2a0",
            Divider = "#2f2a22"
        },
        Typography = new Typography { Default = new DefaultTypography { FontFamily = ["Aptos", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] } }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
