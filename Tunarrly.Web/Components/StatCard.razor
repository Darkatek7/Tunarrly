<MudCard Class="stat-card metric-card pa-4" Elevation="0">
    <MudText Typo="Typo.caption" Class="metric-label">@Title</MudText>
    <MudText Typo="Typo.h4" Class="metric-value fw-800">@Value</MudText>
</MudCard>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
}
