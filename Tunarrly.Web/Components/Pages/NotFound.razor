@page "/not-found"
@layout MainLayout

<div class="page-stack">
    <section class="page-hero detail-hero">
        <div>
            <div class="eyebrow">404</div>
            <MudText Typo="Typo.h3" Class="fw-800 page-title">Page not found</MudText>
            <MudText Typo="Typo.body1" Class="page-subtitle">The route you opened does not exist in Tunarrly.</MudText>
        </div>
        <div class="page-actions"><MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Back to Dashboard</MudButton></div>
    </section>
</div>
