@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="page-stack">
<section class="page-hero detail-hero">
    <div>
        <div class="eyebrow">Application error</div>
        <MudText Typo="Typo.h3" Class="fw-800 page-title">Something went wrong</MudText>
        <MudText Typo="Typo.body1" Class="page-subtitle">An error occurred while processing your request.</MudText>
    </div>
    <div class="page-actions"><MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Back to Dashboard</MudButton></div>
</section>

@if (ShowRequestId)
{
    <div class="content-panel"><div class="data-pair"><span>Request ID</span><strong><code>@RequestId</code></strong></div></div>
}

<div class="notice-panel warning"><MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" /> <span>Development mode can show detailed errors for local debugging, but should not be enabled for deployed applications because it may expose sensitive information.</span></div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
