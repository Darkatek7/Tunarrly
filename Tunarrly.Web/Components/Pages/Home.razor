@page "/"
@inject IDashboardService Dashboard
@inject IScanJobService ScanJobs
@inject ILidarrSyncService LidarrSync
@inject IRecommendationService Recommendations
@inject ISnackbar Snackbar

<PageTitle>Tunarrly Dashboard</PageTitle>

<MudStack Spacing="4" Class="dashboard-page">
    <section class="command-header">
        <div class="command-copy">
            <div class="eyebrow">Music discovery console</div>
            <MudText Typo="Typo.h3" Class="fw-800 dashboard-title">AI-assisted music discovery for Lidarr</MudText>
            <MudText Typo="Typo.body1" Class="dashboard-subtitle">Keep Lidarr in sync, scan your read-only library, and turn local listening evidence into explainable artist recommendations.</MudText>
        </div>
        <div class="command-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ScanLibrary" Disabled="_busy" Class="action-primary">Scan Library</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="SyncLidarr" Disabled="_busy">Sync Lidarr</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GenerateLocal" Disabled="_busy">Generate Local Recommendations</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Tertiary" OnClick="GenerateAi" Disabled="_busy">Generate AI Recommendations</MudButton>
        </div>
    </section>

    @if (_stats is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudGrid Class="metric-grid">
            <MudItem xs="12" sm="6" md="3"><StatCard Title="Lidarr Artists" Value="@_stats.LidarrArtists.ToString()" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><StatCard Title="Library Artists" Value="@_stats.LibraryArtists.ToString()" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><StatCard Title="Tracks Indexed" Value="@_stats.LibraryTracks.ToString()" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><StatCard Title="New Recommendations" Value="@_stats.NewRecommendations.ToString()" /></MudItem>
        </MudGrid>

        <MudGrid Class="dashboard-grid">
            <MudItem xs="12" lg="8">
                <MudCard Class="stat-card workflow-panel pa-4" Elevation="0">
                    <div class="panel-heading">
                        <div>
                            <div class="eyebrow">Setup flow</div>
                            <MudText Typo="Typo.h5" Class="fw-800">First-run checklist</MudText>
                        </div>
                        <span class="status-pill">@CompletedSteps(_stats) / 5 ready</span>
                    </div>
                    <MudText Typo="Typo.body2" Class="panel-subtitle mb-3">Complete these once to move from an empty install to useful, explainable recommendations.</MudText>
                    <MudStack Spacing="2">
                        @ChecklistStep("Configure Lidarr", _stats.LidarrConfigured, "Save your Lidarr URL and API key in Settings.", "settings")
                        @ChecklistStep("Choose Lidarr add defaults", _stats.LidarrDefaultsConfigured, "Load root folders and quality/metadata profiles before adding artists.", "settings")
                        @ChecklistStep("Sync Lidarr artists", _stats.LidarrArtists > 0, "Import monitored artists so Tunarrly avoids recommending what you already track.", "artists")
                        @ChecklistStep("Scan the read-only library", _stats.LibraryTracks > 0, "Index local artists, albums, tracks, genres, and collaborator credits.", "library")
                        @ChecklistStep("Generate local recommendations", _stats.NewRecommendations > 0 || _stats.LastRecommendationAt is not null, "Run local recommendations before enabling optional AI.", "recommendations")
                    </MudStack>
                </MudCard>
            </MudItem>
            <MudItem xs="12" lg="4">
                <MudStack Spacing="3">
                    <MudCard Class="stat-card now-panel pa-4" Elevation="0">
                        <div class="eyebrow">Now playing</div>
                        <MudText Typo="Typo.h6" Class="fw-800">System status</MudText>
                        <div class="status-row"><span>Lidarr</span><strong>@(_stats.LidarrConfigured ? "Configured" : "Needs setup")</strong></div>
                        <div class="status-row"><span>Last scan</span><strong>@(_stats.LastScanStatus ?? "Never run")</strong></div>
                        <div class="status-row"><span>Files scanned</span><strong>@_stats.LastScanFilesScanned ok / @_stats.LastScanFilesFailed failed</strong></div>
                        <div class="status-row"><span>AI provider</span><strong>@(_stats.AiEnabled ? "Enabled" : "Off by default")</strong></div>
                    </MudCard>
                    <MudCard Class="stat-card now-panel pa-4" Elevation="0">
                        <div class="eyebrow">Refresh history</div>
                        <div class="status-row"><span>Scan</span><strong>@When(_stats.LastScanAt)</strong></div>
                        <div class="status-row"><span>Lidarr sync</span><strong>@When(_stats.LastLidarrSyncAt)</strong></div>
                        <div class="status-row"><span>Local recs</span><strong>@When(_stats.LastRecommendationAt)</strong></div>
                        <div class="status-row"><span>AI run</span><strong>@When(_stats.LastAiRunAt)</strong></div>
                    </MudCard>
                    <MudCard Class="stat-card now-panel accent-panel pa-4" Elevation="0">
                        <div class="eyebrow">Recommendation mix</div>
                        <MudText Typo="Typo.h4" Class="fw-800">@_stats.AiRecommendations</MudText>
                        <MudText Typo="Typo.body2">AI recommendations stored. Local recommendations remain the baseline.</MudText>
                    </MudCard>
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudAlert Severity="@(_stats.LidarrConfigured ? Severity.Success : Severity.Warning)">
                    Lidarr configuration: @(_stats.LidarrConfigured ? "configured" : "missing base URL or API key")
                </MudAlert>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudAlert Severity="@(_stats.AiEnabled ? Severity.Info : Severity.Normal)">
                    AI provider: @(_stats.AiEnabled ? "enabled" : "disabled by default")
                </MudAlert>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    private DashboardStats? _stats;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadStats();

    private async Task LoadStats() => _stats = await Dashboard.GetStatsAsync();

    private async Task Run(Func<Task<OperationResult>> action)
    {
        _busy = true;
        var result = await action();
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        await LoadStats();
        _busy = false;
    }

    private Task ScanLibrary() => Run(() => ScanJobs.EnqueueScanAsync());
    private Task SyncLidarr() => Run(() => LidarrSync.SyncArtistsAsync());
    private Task GenerateLocal() => Run(() => Recommendations.GenerateLocalAsync());
    private Task GenerateAi() => Run(() => Recommendations.GenerateAiAsync());
    private static string When(DateTimeOffset? value) => value?.LocalDateTime.ToString("g") ?? "Never";

    private static int CompletedSteps(DashboardStats stats)
    {
        var completed = 0;
        if (stats.LidarrConfigured) completed++;
        if (stats.LidarrDefaultsConfigured) completed++;
        if (stats.LidarrArtists > 0) completed++;
        if (stats.LibraryTracks > 0) completed++;
        if (stats.NewRecommendations > 0 || stats.LastRecommendationAt is not null) completed++;
        return completed;
    }

    private RenderFragment ChecklistStep(string title, bool complete, string description, string href) => @<MudPaper Class="pa-3 onboarding-step" Outlined="true">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <span class="timeline-dot @(complete ? "complete" : "open")"></span>
            <div class="flex-grow-1">
                <MudText Typo="Typo.subtitle1" Class="fw-800">@title</MudText>
                <MudText Typo="Typo.body2" Class="panel-subtitle">@description</MudText>
            </div>
            <MudButton Href="@href" Variant="Variant.Text" Color="@(complete ? Color.Success : Color.Primary)">@(complete ? "Review" : "Open")</MudButton>
        </MudStack>
    </MudPaper>;
}
