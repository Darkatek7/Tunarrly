@page "/library"
@inject IDbContextFactory<TunarrlyDbContext> DbFactory
@inject IScanJobService ScanJobs
@inject ISnackbar Snackbar

<PageTitle>Library</PageTitle>
<div class="page-stack">
<section class="page-hero">
    <div>
        <div class="eyebrow">Read-only index</div>
        <MudText Typo="Typo.h3" Class="fw-800 page-title">Library</MudText>
        <MudText Typo="Typo.body1" Class="page-subtitle">Read-only music metadata that powers local recommendations.</MudText>
    </div>
    <div class="page-actions">
    <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="Scan">Scan Library</MudButton>
    </div>
</section>
<MudGrid>
    <MudItem xs="12" md="4"><StatCard Title="Artists" Value="@_artistCount.ToString()" /></MudItem>
    <MudItem xs="12" md="4"><StatCard Title="Albums" Value="@_albumCount.ToString()" /></MudItem>
    <MudItem xs="12" md="4"><StatCard Title="Tracks" Value="@_trackCount.ToString()" /></MudItem>
</MudGrid>
@if (_trackCount == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">No tracks indexed yet. Mount your library read-only, then scan it to build local recommendation evidence.</MudAlert>
}
</div>

@code {
    private int _artistCount;
    private int _albumCount;
    private int _trackCount;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _artistCount = await db.LibraryArtists.CountAsync();
        _albumCount = await db.LibraryAlbums.CountAsync();
        _trackCount = await db.LibraryTracks.CountAsync();
    }

    private async Task Scan()
    {
        var result = await ScanJobs.EnqueueScanAsync();
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        await Load();
    }
}
