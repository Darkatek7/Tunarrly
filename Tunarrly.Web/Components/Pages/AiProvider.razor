@page "/ai-provider"
@inject IAppSettingsService Settings
@inject IAiProviderClient Ai
@inject IAiContextService AiContext
@inject ISnackbar Snackbar

<PageTitle>AI Provider</PageTitle>
<MudText Typo="Typo.h3" Class="fw-800 mb-4">AI Provider</MudText>
@if (_options is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        AI is optional and disabled by default. When enabled, Tunarrly sends a compact music profile to your configured AI provider, including artists, genres, local recommendations, ignored artists, and Lidarr artists to avoid. It must not send local file paths, API keys, tokens, or raw filesystem structure.
    </MudAlert>
    <MudCard Class="pa-4" Elevation="0">
        <MudGrid>
            <MudItem xs="12"><MudSwitch T="bool" Label="Enable AI recommendations" @bind-Value="_options.Enabled" Color="Color.Primary" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField Label="Base URL" @bind-Value="_options.BaseUrl" /></MudItem>
            <MudItem xs="12" md="6">
                <MudTextField Label="Token" @bind-Value="_options.ApiKey" InputType="InputType.Password" HelperText="@(_secretConfigured ? "A token is saved. Leave blank to keep it." : "Optional for local providers that do not require auth.")" />
                <MudButton Size="Size.Small" Color="Color.Warning" Disabled="!_secretConfigured" OnClick="ClearSecret">Clear saved token</MudButton>
            </MudItem>
            <MudItem xs="12" md="6"><MudTextField Label="Model" @bind-Value="_options.Model" /></MudItem>
            <MudItem xs="12" md="6"><MudNumericField Label="Temperature" @bind-Value="_options.Temperature" Min="0" Max="2" Step="0.1" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField Label="Timeout seconds" @bind-Value="_options.TimeoutSeconds" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField Label="Max input artists" @bind-Value="_options.MaxInputArtists" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField Label="Max recommendations" @bind-Value="_options.MaxRecommendations" /></MudItem>
        </MudGrid>
        <MudStack Row="true" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveClicked">Save</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Test">Test AI provider</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="LoadPreview">Preview AI payload</MudButton>
        </MudStack>
    </MudCard>

    @if (_preview is not null)
    {
        <MudGrid Class="mt-4">
            <MudItem xs="12" md="4">
                <MudCard Class="pa-4" Elevation="0">
                    <MudText Typo="Typo.h5" Class="fw-800">What is sent</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Approx. @_preview.ApproximateBytes bytes before provider transport overhead.</MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var item in _preview.Included)
                        {
                            <MudListItem Icon="@Icons.Material.Filled.CheckCircle">@item</MudListItem>
                        }
                    </MudList>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Class="pa-4" Elevation="0">
                    <MudText Typo="Typo.h5" Class="fw-800">What is not sent</MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var item in _preview.Excluded)
                        {
                            <MudListItem Icon="@Icons.Material.Filled.Block">@item</MudListItem>
                        }
                    </MudList>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudAlert Severity="Severity.Info">This preview is the same sanitized context used for AI recommendation requests. It does not include local paths or secrets.</MudAlert>
            </MudItem>
            <MudItem xs="12">
                <MudCard Class="pa-4" Elevation="0">
                    <MudText Typo="Typo.h5" Class="fw-800">Payload preview</MudText>
                    <pre>@_preview.PayloadJson</pre>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
}

@code {
    private AiOptions? _options;
    private AiContextPreview? _preview;
    private bool _secretConfigured;

    protected override async Task OnInitializedAsync()
    {
        _options = await Settings.GetAiOptionsAsync();
        _secretConfigured = !string.IsNullOrWhiteSpace(_options.ApiKey);
        _options.ApiKey = string.Empty;
    }

    private async Task SaveClicked() => await Save();

    private async Task<bool> Save()
    {
        var options = _options!;
        var errors = SettingsValidator.ValidateAi(options);
        if (errors.Count > 0)
        {
            foreach (var error in errors) Snackbar.Add(error, Severity.Error);
            return false;
        }

        await Settings.SaveAiOptionsAsync(options);
        _secretConfigured = _secretConfigured || !string.IsNullOrWhiteSpace(options.ApiKey);
        options.ApiKey = string.Empty;
        Snackbar.Add("AI provider settings saved.", Severity.Success);
        return true;
    }

    private async Task Test()
    {
        if (!await Save()) return;
        var result = await Ai.TestConnectionAsync();
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
    }

    private async Task LoadPreview()
    {
        var maxArtists = Math.Max(1, _options?.MaxInputArtists ?? 200);
        _preview = await AiContext.BuildPreviewAsync(maxArtists);
    }

    private async Task ClearSecret()
    {
        await Settings.ClearSecretAsync("AI:ApiKey");
        _secretConfigured = false;
        Snackbar.Add("Saved AI token cleared.", Severity.Success);
    }
}
