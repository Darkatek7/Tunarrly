@page "/artists"
@inject IDbContextFactory<TunarrlyDbContext> DbFactory

<PageTitle>Artists</PageTitle>
<div class="page-stack">
<section class="page-hero">
    <div>
        <div class="eyebrow">Catalog view</div>
        <MudText Typo="Typo.h3" Class="fw-800 page-title">Artists</MudText>
        <MudText Typo="Typo.body1" Class="page-subtitle">Compare monitored Lidarr artists with artists discovered from indexed library metadata.</MudText>
    </div>
</section>
<div class="table-panel">
<MudTabs Rounded="true" Elevation="0">
    <MudTabPanel Text="Lidarr">
        <MudTable Items="_lidarr" Hover="true" Elevation="0">
            <HeaderContent><MudTh>Name</MudTh><MudTh>Monitored</MudTh><MudTh>Path</MudTh></HeaderContent>
            <RowTemplate><MudTd>@context.Name</MudTd><MudTd>@context.Monitored</MudTd><MudTd>@context.Path</MudTd></RowTemplate>
            <NoRecordsContent>
                <MudAlert Severity="Severity.Info">No Lidarr artists synced yet. Use the Lidarr Connection page to sync monitored artists.</MudAlert>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>
    <MudTabPanel Text="Library">
        <MudTable Items="_library" Hover="true" Elevation="0">
            <HeaderContent><MudTh>Name</MudTh><MudTh>Source</MudTh></HeaderContent>
            <RowTemplate><MudTd>@context.Name</MudTd><MudTd>@context.Source</MudTd></RowTemplate>
            <NoRecordsContent>
                <MudAlert Severity="Severity.Info">No library artists indexed yet. Scan your read-only music library first.</MudAlert>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>
</MudTabs>
</div>
</div>

@code {
    private List<LidarrArtist> _lidarr = [];
    private List<LibraryArtist> _library = [];
    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _lidarr = await db.LidarrArtists.OrderBy(x => x.Name).Take(500).ToListAsync();
        _library = await db.LibraryArtists.OrderBy(x => x.Name).Take(500).ToListAsync();
    }
}
