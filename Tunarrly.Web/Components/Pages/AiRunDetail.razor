@page "/ai-runs/{Id:int}"
@inject IDbContextFactory<TunarrlyDbContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>AI Run Detail</PageTitle>

@if (_run is null)
{
    <div class="page-stack">
        <section class="page-hero detail-hero">
            <div>
                <div class="eyebrow">Missing record</div>
                <MudText Typo="Typo.h3" Class="fw-800 page-title">AI run not found</MudText>
                <MudText Typo="Typo.body1" Class="page-subtitle">This AI run may have been deleted or the link may be stale.</MudText>
            </div>
            <div class="page-actions"><MudButton Href="/ai-runs" Variant="Variant.Filled" Color="Color.Primary">Back to AI Runs</MudButton></div>
        </section>
    </div>
}
else
{
    <MudStack Spacing="4" Class="page-stack">
        <section class="page-hero detail-hero">
            <div>
                <div class="eyebrow">AI audit detail</div>
                <MudText Typo="Typo.h3" Class="fw-800 page-title">AI Run #@_run.Id</MudText>
                <MudText Typo="Typo.body1" Class="page-subtitle">Sanitized provider request and stored output summary for this recommendation run.</MudText>
            </div>
            <MudStack Row="true" Spacing="1" Class="mt-2">
                <MudChip T="string" Color="@StatusColor(_run.Status)">@_run.Status</MudChip>
                <MudChip T="string" Variant="Variant.Outlined">@_run.Model</MudChip>
            </MudStack>
        </section>

        <div class="notice-panel"><MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" /> <span>AI run details are sanitized. Tunarrly should not send local file paths, API keys, provider tokens, or raw filesystem structure to AI providers.</span></div>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Class="detail-panel" Elevation="0">
                    <div class="eyebrow">Provider</div>
                    <div class="data-pair"><span>Base URL</span><strong>@_run.ProviderBaseUrl</strong></div>
                    <div class="data-pair"><span>Started</span><strong>@_run.StartedAt.LocalDateTime</strong></div>
                    <div class="data-pair"><span>Finished</span><strong>@_run.FinishedAt?.LocalDateTime</strong></div>
                    @if (!string.IsNullOrWhiteSpace(_run.ErrorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-4">@_run.ErrorMessage</MudAlert>
                    }
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard Class="detail-panel code-panel" Elevation="0">
                    <MudText Typo="Typo.h5">Input Summary</MudText>
                    <pre>@Pretty(_run.InputSummaryJson)</pre>
                </MudCard>
            </MudItem>
            <MudItem xs="12">
                <MudCard Class="detail-panel code-panel" Elevation="0">
                    <MudText Typo="Typo.h5">Output Summary</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Class="my-2" OnClick="ClearOutput">Delete stored output</MudButton>
                    <pre>@Pretty(_run.OutputJson)</pre>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudStack>
}

@code {
    [Parameter] public int Id { get; set; }
    private AiRecommendationRun? _run;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _run = await db.AiRecommendationRuns.FindAsync(Id);
    }

    private static string Pretty(string json)
    {
        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return json;
        }
    }

    private async Task ClearOutput()
    {
        if (_run is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var run = await db.AiRecommendationRuns.FindAsync(Id);
        if (run is null) return;
        run.OutputJson = "{}";
        await db.SaveChangesAsync();
        _run.OutputJson = "{}";
        Snackbar.Add("Stored AI output deleted.", Severity.Success);
    }

    private static Color StatusColor(string status) => status == JobStatuses.Completed ? Color.Success : status == JobStatuses.Failed ? Color.Error : Color.Info;
}
