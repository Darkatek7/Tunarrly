@page "/ai-runs/{Id:int}"
@inject IDbContextFactory<TunarrlyDbContext> DbFactory

<PageTitle>AI Run Detail</PageTitle>

@if (_run is null)
{
    <MudAlert Severity="Severity.Warning">AI run not found.</MudAlert>
}
else
{
    <MudStack Spacing="4">
        <MudCard Class="pa-5" Elevation="0">
            <MudText Typo="Typo.h3" Class="fw-800">AI Run #@_run.Id</MudText>
            <MudStack Row="true" Spacing="1" Class="mt-2">
                <MudChip T="string" Color="@StatusColor(_run.Status)">@_run.Status</MudChip>
                <MudChip T="string" Variant="Variant.Outlined">@_run.Model</MudChip>
            </MudStack>
        </MudCard>

        <MudAlert Severity="Severity.Info">
            AI run details are sanitized. Tunarrly should not send local file paths, API keys, provider tokens, or raw filesystem structure to AI providers.
        </MudAlert>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Class="pa-4" Elevation="0">
                    <MudText Typo="Typo.h5">Provider</MudText>
                    <MudText>@_run.ProviderBaseUrl</MudText>
                    <MudText Typo="Typo.h6" Class="mt-4">Started</MudText>
                    <MudText>@_run.StartedAt.LocalDateTime</MudText>
                    <MudText Typo="Typo.h6" Class="mt-4">Finished</MudText>
                    <MudText>@_run.FinishedAt?.LocalDateTime</MudText>
                    @if (!string.IsNullOrWhiteSpace(_run.ErrorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-4">@_run.ErrorMessage</MudAlert>
                    }
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard Class="pa-4" Elevation="0">
                    <MudText Typo="Typo.h5">Input Summary</MudText>
                    <pre>@Pretty(_run.InputSummaryJson)</pre>
                </MudCard>
            </MudItem>
            <MudItem xs="12">
                <MudCard Class="pa-4" Elevation="0">
                    <MudText Typo="Typo.h5">Output Summary</MudText>
                    <pre>@Pretty(_run.OutputJson)</pre>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudStack>
}

@code {
    [Parameter] public int Id { get; set; }
    private AiRecommendationRun? _run;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _run = await db.AiRecommendationRuns.FindAsync(Id);
    }

    private static string Pretty(string json)
    {
        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return json;
        }
    }

    private static Color StatusColor(string status) => status == JobStatuses.Completed ? Color.Success : status == JobStatuses.Failed ? Color.Error : Color.Info;
}
