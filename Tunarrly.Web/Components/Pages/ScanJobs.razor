@page "/scan-jobs"
@implements IAsyncDisposable
@inject IDbContextFactory<TunarrlyDbContext> DbFactory
@inject IScanJobService ScanJobService
@inject ISnackbar Snackbar

<PageTitle>Scan Jobs</PageTitle>
<div class="page-stack">
<section class="page-hero">
    <div>
        <div class="eyebrow">Scanner queue</div>
        <MudText Typo="Typo.h3" Class="fw-800 page-title">Scan Jobs</MudText>
        <MudText Typo="Typo.body1" Class="page-subtitle">Track read-only library scans, cancellation status, and filename-only progress.</MudText>
    </div>
</section>
<div class="notice-panel"><MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" /> <span>Scan progress hides local file paths. Current and failed files are shown by filename only.</span></div>
<div class="table-panel">
<MudTable Items="_jobs" Hover="true" Elevation="0">
    <HeaderContent>
        <MudTh>Status</MudTh><MudTh>Library</MudTh><MudTh>Progress</MudTh><MudTh>Indexed</MudTh><MudTh>Skipped</MudTh><MudTh>Failed</MudTh><MudTh>Current</MudTh><MudTh>Started</MudTh><MudTh>Finished</MudTh><MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><MudChip T="string" Color="@StatusColor(context.Status)">@context.Status</MudChip></MudTd>
        <MudTd>Configured library</MudTd>
        <MudTd>
            <MudProgressLinear Value="@Progress(context)" Color="Color.Primary" />
            <MudText Typo="Typo.caption">@Processed(context) / @context.FilesDiscovered files processed</MudText>
        </MudTd>
        <MudTd>@context.FilesScanned</MudTd>
        <MudTd>@context.FilesSkipped</MudTd>
        <MudTd>
            @context.FilesFailed
            @foreach (var file in FailedFiles(context))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-1">@file</MudChip>
            }
        </MudTd>
        <MudTd>@(context.CurrentFile ?? "-")</MudTd>
        <MudTd>@context.StartedAt.LocalDateTime</MudTd>
        <MudTd>@context.FinishedAt?.LocalDateTime</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Disabled="context.Status != JobStatuses.Running" OnClick="CancelRunningScan">Cancel</MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>
</div>
</div>

@code {
    private List<ScanJob> _jobs = [];
    private PeriodicTimer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = RefreshLoopAsync();
        await Load();
    }

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _jobs = (await db.ScanJobs.ToListAsync()).OrderByDescending(x => x.StartedAt).Take(50).ToList();
    }

    private async Task RefreshLoopAsync()
    {
        while (_timer is not null && await _timer.WaitForNextTickAsync())
        {
            await Load();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CancelRunningScan()
    {
        var result = await ScanJobService.CancelRunningScanAsync();
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        await Load();
    }

    public ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        return ValueTask.CompletedTask;
    }

    private static Color StatusColor(string status) => status switch
    {
        JobStatuses.Completed => Color.Success,
        JobStatuses.Failed => Color.Error,
        JobStatuses.Cancelled => Color.Warning,
        _ => Color.Info
    };

    private static int Processed(ScanJob job) => job.FilesScanned + job.FilesSkipped + job.FilesFailed;

    private static double Progress(ScanJob job) => job.FilesDiscovered == 0 ? 0 : Math.Clamp(Processed(job) * 100d / job.FilesDiscovered, 0, 100);

    private static IReadOnlyList<string> FailedFiles(ScanJob job)
    {
        try
        {
            return JsonSerializer.Deserialize<IReadOnlyList<string>>(job.FailureSummaryJson) ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }
}
