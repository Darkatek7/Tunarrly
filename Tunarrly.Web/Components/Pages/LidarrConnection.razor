@page "/lidarr"
@inject ILidarrClient Lidarr
@inject ILidarrSyncService Sync
@inject ISnackbar Snackbar

<PageTitle>Lidarr Connection</PageTitle>
<MudCard Class="hero-card pa-5 mb-4" Elevation="0">
    <MudText Typo="Typo.h3" Class="fw-800">Lidarr Connection</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary">Verify API access and import monitored artists before generating recommendations.</MudText>
    <MudStack Row="true" Spacing="2" Class="mt-4" Style="flex-wrap: wrap;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Test">Test Lidarr connection</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="SyncArtists">Sync Lidarr artists</MudButton>
    </MudStack>
</MudCard>
@if (_message is not null)
{
    <MudAlert Severity="@(_success ? Severity.Success : Severity.Error)">@_message</MudAlert>
}

@code {
    private string? _message;
    private bool _success;

    private async Task Test() => await Run(() => Lidarr.TestConnectionAsync());
    private async Task SyncArtists() => await Run(() => Sync.SyncArtistsAsync());

    private async Task Run(Func<Task<OperationResult>> action)
    {
        var result = await action();
        _message = result.Message;
        _success = result.Success;
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
    }
}
