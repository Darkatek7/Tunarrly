@page "/recommendations/{Id:int}"
@inject IDbContextFactory<TunarrlyDbContext> DbFactory
@inject ILidarrClient Lidarr
@inject IRecommendationService RecommendationService
@inject IAppSettingsService Settings
@inject ISnackbar Snackbar

<PageTitle>Recommendation Detail</PageTitle>
@if (_recommendation is null)
{
    <div class="page-stack">
        <section class="page-hero detail-hero">
            <div>
                <div class="eyebrow">Missing record</div>
                <MudText Typo="Typo.h3" Class="fw-800 page-title">Recommendation not found</MudText>
                <MudText Typo="Typo.body1" Class="page-subtitle">This recommendation may have been deleted or the link may be stale.</MudText>
            </div>
            <div class="page-actions"><MudButton Href="/recommendations" Variant="Variant.Filled" Color="Color.Primary">Back to Recommendations</MudButton></div>
        </section>
    </div>
}
else
{
    <MudStack Spacing="4" Class="page-stack">
        <section class="page-hero detail-hero">
            <div>
                <div class="eyebrow">Recommendation detail</div>
                <MudText Typo="Typo.h3" Class="fw-800 page-title">@_recommendation.ArtistName</MudText>
                <MudText Typo="Typo.body1" Class="page-subtitle">Review the evidence, indexed context, and explicit Lidarr add payload before taking action.</MudText>
            </div>
            <MudStack Row="true" Spacing="1" Class="mt-2">
                <MudChip T="string" Color="Color.Primary">Score @_recommendation.Score</MudChip>
                @if (_recommendation.Confidence is not null)
                {
                    <MudChip T="string" Color="Color.Info">Confidence @_recommendation.Confidence</MudChip>
                }
                <MudChip T="string" Color="Color.Secondary">@_recommendation.Source</MudChip>
                <MudChip T="string" Variant="Variant.Outlined" Color="@StatusColor(_recommendation.Status)">@_recommendation.Status</MudChip>
            </MudStack>
        </section>
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudCard Class="detail-panel" Elevation="0">
                    <MudText Typo="Typo.h5" Class="fw-800">Why this artist surfaced</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@ScoreNarrative(_recommendation)</MudText>
                    <MudList T="string">
                        @foreach (var reason in Reasons)
                        {
                            <MudListItem>@reason</MudListItem>
                        }
                    </MudList>
                    <MudText Typo="Typo.h6" Class="mt-4">Evidence groups</MudText>
                    @if (_evidence.Count == 0)
                    {
                        <MudText Color="Color.Secondary">No structured evidence has been stored for this recommendation yet.</MudText>
                    }
                    @foreach (var group in EvidenceGroups)
                    {
                        <MudPaper Class="pa-3 my-2 evidence-group" Outlined="true">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle1" Class="fw-800">@EvidenceTitle(group.Key)</MudText>
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">+@group.Sum(x => x.Weight)</MudChip>
                            </MudStack>
                            @foreach (var item in group.OrderByDescending(x => x.Weight))
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">@item.Summary</MudText>
                                @if (item.Data.Count > 0)
                                {
                                    <MudStack Row="true" Spacing="1" Class="mt-1" Style="flex-wrap: wrap;">
                                        @foreach (var detail in item.Data)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Label(detail.Key): @detail.Value</MudChip>
                                        }
                                    </MudStack>
                                }
                            }
                        </MudPaper>
                    }
                    <MudText Typo="Typo.h6" Class="mt-4">Genres</MudText>
                    @if (Genres.Count == 0)
                    {
                        <MudText Color="Color.Secondary">No genres captured yet.</MudText>
                    }
                    else
                    {
                        @foreach (var genre in Genres)
                        {
                            <MudChip T="string" Class="ma-1" Color="Color.Secondary" Variant="Variant.Outlined">@genre</MudChip>
                        }
                    }
                    <MudText Typo="Typo.h6" Class="mt-4">Related Artists</MudText>
                    @if (Related.Count == 0)
                    {
                        <MudText Color="Color.Secondary">No AI-provided related artists captured yet.</MudText>
                    }
                    else
                    {
                        @foreach (var artist in Related)
                        {
                            <MudChip T="string" Class="ma-1" Variant="Variant.Outlined">@artist</MudChip>
                        }
                    }
                </MudCard>

                <MudCard Class="detail-panel mt-4" Elevation="0">
                    <MudText Typo="Typo.h5" Class="fw-800">Indexed tracks and albums</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Only tag-derived titles, artists, genres, and years are shown. Local file paths stay hidden.</MudText>
                    @if (_relatedTracks.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">No matching indexed track credits were found for this recommendation.</MudAlert>
                    }
                    else
                    {
                        <MudStack Row="true" Spacing="1" Class="mb-3" Style="flex-wrap: wrap;">
                            @foreach (var album in RelatedAlbumTitles.Take(8))
                            {
                                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">@album</MudChip>
                            }
                        </MudStack>
                        <MudTable Items="_relatedTracks" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Track</MudTh><MudTh>Album</MudTh><MudTh>Main artist</MudTh><MudTh>Credit</MudTh><MudTh>Context</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Title</MudTd>
                                <MudTd>@(context.AlbumTitle ?? "Unknown")</MudTd>
                                <MudTd>@(context.MainArtist ?? "Unknown")</MudTd>
                                <MudTd>@context.CreditType</MudTd>
                                <MudTd>@TrackContext(context)</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Class="detail-panel" Elevation="0">
                    <MudText Typo="Typo.h5">Add to Lidarr</MudText>
                    <MudAlert Severity="Severity.Info" Class="my-3">Search Lidarr, select the correct match, then confirm. Tunarrly never auto-adds artists.</MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Search">Search Lidarr</MudButton>
                    @if (_matches.Count > 0)
                    {
                        <MudRadioGroup T="LidarrLookupResult" @bind-Value="_selected">
                            @foreach (var match in _matches)
                            {
                                <MudRadio T="LidarrLookupResult" Value="match">@match.ArtistName @match.Disambiguation</MudRadio>
                            }
                        </MudRadioGroup>
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.h6">Add options</MudText>
                        <MudTextField Label="Root folder" @bind-Value="_rootFolderPath" />
                        <MudNumericField Label="Quality profile ID" @bind-Value="_qualityProfileId" Min="1" />
                        <MudNumericField Label="Metadata profile ID" @bind-Value="_metadataProfileId" Min="1" />
                        <MudTextField Label="Monitor behavior" @bind-Value="_monitor" />
                        <MudSwitch T="bool" Label="Monitor artist" @bind-Value="_monitored" Color="Color.Primary" />
                        <MudSwitch T="bool" Label="Search for missing albums after add" @bind-Value="_searchForMissingAlbums" Color="Color.Warning" />
                        <MudAlert Severity="Severity.Warning" Class="my-3">Lidarr search is explicit per add. Leave it off to add the artist without triggering album searches.</MudAlert>
                        <MudText Typo="Typo.h6">Payload preview</MudText>
                        <pre>@AddPayloadPreview</pre>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="_selected is null" OnClick="ConfirmAdd">Confirm add</MudButton>
                    }
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudStack>
}

@code {
    [Parameter] public int Id { get; set; }
    private Recommendation? _recommendation;
    private List<RecommendationEvidence> _evidence = [];
    private List<RelatedTrackRow> _relatedTracks = [];
    private List<LidarrLookupResult> _matches = [];
    private LidarrLookupResult? _selected;
    private string _rootFolderPath = string.Empty;
    private int _qualityProfileId = 1;
    private int _metadataProfileId = 1;
    private string _monitor = "all";
    private bool _monitored = true;
    private bool _searchForMissingAlbums;
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private IReadOnlyList<string> Reasons => Read(_recommendation?.ReasonJson);
    private IReadOnlyList<string> Genres => Read(_recommendation?.GenresJson);
    private IReadOnlyList<string> Related => Read(_recommendation?.RelatedArtistsJson);
    private IEnumerable<IGrouping<string, RecommendationEvidence>> EvidenceGroups => _evidence.GroupBy(x => x.Type).OrderByDescending(x => x.Sum(e => e.Weight));
    private IEnumerable<string> RelatedAlbumTitles => _relatedTracks.Select(x => x.AlbumTitle).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct()!;
    private string AddPayloadPreview => _selected is null
        ? "Select a Lidarr match to preview the add payload."
        : JsonSerializer.Serialize(new
        {
            artistName = _selected.ArtistName,
            foreignArtistId = _selected.ForeignArtistId,
            monitored = _monitored,
            rootFolderPath = _rootFolderPath,
            qualityProfileId = _qualityProfileId,
            metadataProfileId = _metadataProfileId,
            addOptions = new { monitor = _monitor, searchForMissingAlbums = _searchForMissingAlbums }
        }, new JsonSerializerOptions(JsonSerializerDefaults.Web) { WriteIndented = true });

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var lidarr = await Settings.GetLidarrOptionsAsync();
        _rootFolderPath = lidarr.DefaultRootFolder;
        _qualityProfileId = lidarr.DefaultQualityProfileId;
        _metadataProfileId = lidarr.DefaultMetadataProfileId;
        _monitor = lidarr.DefaultMonitor;
        _searchForMissingAlbums = lidarr.SearchOnAdd;
        _recommendation = await db.Recommendations.FindAsync(Id);
        if (_recommendation is not null)
        {
            var relations = await db.ArtistRelations.Where(x => x.TargetNormalizedName == _recommendation.NormalizedArtistName).ToListAsync();
            _evidence = relations
                .SelectMany(x => JsonSerializer.Deserialize<IReadOnlyList<RecommendationEvidence>>(x.EvidenceJson, JsonOptions) ?? [])
                .ToList();
            _relatedTracks = await db.TrackArtistCredits
                .Where(x => x.NormalizedArtistName == _recommendation.NormalizedArtistName)
                .OrderBy(x => x.Track!.Title)
                .Select(x => new RelatedTrackRow(
                    x.Track!.Title,
                    x.Track.Album == null ? null : x.Track.Album.Title,
                    x.Track.MainArtist == null ? null : x.Track.MainArtist.Name,
                    x.CreditType,
                    x.Track.Genre,
                    x.Track.Year))
                .Take(12)
                .ToListAsync();
        }
    }

    private async Task Search()
    {
        if (_recommendation is null) return;
        _matches = (await Lidarr.SearchArtistAsync(_recommendation.ArtistName)).ToList();
        Snackbar.Add(_matches.Count == 0 ? "No Lidarr matches found." : $"Found {_matches.Count} Lidarr matches.", Severity.Info);
    }

    private async Task ConfirmAdd()
    {
        if (_recommendation is null || _selected is null) return;
        var options = new LidarrAddOptions(_rootFolderPath, _qualityProfileId, _metadataProfileId, _monitor, _searchForMissingAlbums, _monitored);
        var result = await RecommendationService.AddToLidarrAsync(_recommendation.Id, _selected, options);
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
    }

    private static IReadOnlyList<string> Read(string? json)
        => string.IsNullOrWhiteSpace(json) ? [] : JsonSerializer.Deserialize<IReadOnlyList<string>>(json, JsonOptions) ?? [];

    private static string ScoreNarrative(Recommendation recommendation)
    {
        var confidence = recommendation.Confidence is null ? "" : $" with {recommendation.Confidence}% model confidence";
        return recommendation.Source switch
        {
            RecommendationSources.Hybrid => $"Hybrid recommendation: local library evidence and optional AI both pointed toward this artist{confidence}.",
            RecommendationSources.Ai => $"AI recommendation: generated by the configured provider from a sanitized library summary{confidence}.",
            _ => "Local recommendation: generated from tag-derived library evidence without calling an AI provider."
        };
    }

    private static string EvidenceTitle(string type) => type switch
    {
        "AlreadyInLibrary" => "Already in your library",
        "FeaturedCredit" => "Featured artist credits",
        "RepeatedCollaborator" => "Repeated collaborator signal",
        "SharedGenre" => "Shared genre signal",
        _ => type
    };

    private static string Label(string value) => string.Concat(value.Select((character, index) => index > 0 && char.IsUpper(character) ? $" {char.ToLowerInvariant(character)}" : character.ToString()));

    private static string TrackContext(RelatedTrackRow row)
        => string.Join(" · ", new[] { row.Genre, row.Year?.ToString() }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static Color StatusColor(string status) => status switch
    {
        RecommendationStatuses.AddedToLidarr => Color.Success,
        RecommendationStatuses.FailedToAdd => Color.Error,
        RecommendationStatuses.Ignored => Color.Warning,
        RecommendationStatuses.MaybeLater => Color.Info,
        _ => Color.Default
    };

    private sealed record RelatedTrackRow(string Title, string? AlbumTitle, string? MainArtist, string CreditType, string? Genre, int? Year);
}
