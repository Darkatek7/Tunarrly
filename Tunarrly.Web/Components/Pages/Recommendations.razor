@page "/recommendations"
@inject IDbContextFactory<TunarrlyDbContext> DbFactory
@inject IRecommendationService RecommendationService
@inject ISnackbar Snackbar

<PageTitle>Recommendations</PageTitle>
<div class="page-stack">
<section class="page-hero">
    <div>
        <div class="eyebrow">Discovery queue</div>
        <MudText Typo="Typo.h3" Class="fw-800 page-title">Recommendations</MudText>
        <MudText Typo="Typo.body1" Class="page-subtitle">Review explainable artist recommendations from local library evidence and optional AI enrichment.</MudText>
    </div>
    <div class="page-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateLocal">Generate Local</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="GenerateAi">Generate AI</MudButton>
    </div>
</section>

<div class="filter-panel">
<MudGrid>
    <MudItem xs="12" md="4">
        <MudSelect T="string" Label="Status" @bind-Value="_statusFilter">
            @foreach (var status in _statusFilters)
            {
                <MudSelectItem T="string" Value="@status">@status</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudSelect T="string" Label="Source" @bind-Value="_sourceFilter">
            @foreach (var source in _sourceFilters)
            {
                <MudSelectItem T="string" Value="@source">@source</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudSelect T="string" Label="Sort" @bind-Value="_sort">
            <MudSelectItem T="string" Value="@SortScore">Score</MudSelectItem>
            <MudSelectItem T="string" Value="@SortDate">Last calculated</MudSelectItem>
            <MudSelectItem T="string" Value="@SortArtist">Artist</MudSelectItem>
        </MudSelect>
    </MudItem>
</MudGrid>
</div>

<div class="table-panel">
<MudTable Items="FilteredRecommendations" Hover="true" Elevation="0">
    <HeaderContent>
        <MudTh>Artist</MudTh><MudTh>Score</MudTh><MudTh>Confidence</MudTh><MudTh>Source</MudTh><MudTh>Reasons</MudTh><MudTh>Status</MudTh><MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><MudLink Href="@($"recommendations/{context.Id}")">@context.ArtistName</MudLink></MudTd>
        <MudTd><MudChip T="string" Color="Color.Primary">@context.Score</MudChip></MudTd>
        <MudTd>@context.Confidence</MudTd>
        <MudTd><MudChip T="string" Color="@SourceColor(context.Source)">@context.Source</MudChip></MudTd>
        <MudTd>
            @foreach (var reason in Reasons(context).Take(2))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-1">@reason</MudChip>
            }
        </MudTd>
        <MudTd>@context.Status</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" Href="@($"recommendations/{context.Id}")">View</MudButton>
            @if (context.Status is RecommendationStatuses.Ignored or RecommendationStatuses.MaybeLater)
            {
                <MudButton Size="Size.Small" Color="Color.Success" OnClick="() => SetStatus(context.Id, RecommendationStatuses.New)">Restore</MudButton>
            }
            else
            {
                <MudButton Size="Size.Small" Color="Color.Warning" OnClick="() => SetStatus(context.Id, RecommendationStatuses.MaybeLater)">Maybe later</MudButton>
                <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => SetStatus(context.Id, RecommendationStatuses.Ignored)">Ignore</MudButton>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">No recommendations yet. Scan your library and generate local recommendations.</MudAlert>
    </NoRecordsContent>
</MudTable>
</div>
</div>

@code {
    private List<Recommendation> _recommendations = [];
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private const string All = "All";
    private const string SortScore = "Score";
    private const string SortDate = "Last calculated";
    private const string SortArtist = "Artist";
    private string _statusFilter = RecommendationStatuses.New;
    private string _sourceFilter = All;
    private string _sort = SortScore;
    private readonly string[] _statusFilters = [All, RecommendationStatuses.New, RecommendationStatuses.Viewed, RecommendationStatuses.MaybeLater, RecommendationStatuses.Ignored, RecommendationStatuses.AddedToLidarr, RecommendationStatuses.FailedToAdd];
    private readonly string[] _sourceFilters = [All, RecommendationSources.Local, RecommendationSources.Ai, RecommendationSources.Hybrid];

    private IEnumerable<Recommendation> FilteredRecommendations
    {
        get
        {
            var query = _recommendations.AsEnumerable();
            if (_statusFilter != All) query = query.Where(x => x.Status == _statusFilter);
            if (_sourceFilter != All) query = query.Where(x => x.Source == _sourceFilter);
            return _sort switch
            {
                SortDate => query.OrderByDescending(x => x.LastCalculatedAt),
                SortArtist => query.OrderBy(x => x.ArtistName),
                _ => query.OrderByDescending(x => x.Score).ThenBy(x => x.ArtistName)
            };
        }
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _recommendations = await db.Recommendations.OrderByDescending(x => x.Score).ThenBy(x => x.ArtistName).ToListAsync();
    }

    private async Task GenerateLocal() => await Run(() => RecommendationService.GenerateLocalAsync());
    private async Task GenerateAi() => await Run(() => RecommendationService.GenerateAiAsync());
    private async Task SetStatus(int id, string status) => await Run(() => RecommendationService.SetStatusAsync(id, status));

    private async Task Run(Func<Task<OperationResult>> action)
    {
        var result = await action();
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        await Load();
    }

    private static IReadOnlyList<string> Reasons(Recommendation recommendation)
        => JsonSerializer.Deserialize<IReadOnlyList<string>>(recommendation.ReasonJson, JsonOptions) ?? [];

    private static Color SourceColor(string source) => source switch
    {
        RecommendationSources.Ai => Color.Tertiary,
        RecommendationSources.Hybrid => Color.Secondary,
        _ => Color.Primary
    };
}
